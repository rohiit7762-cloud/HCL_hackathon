# Copy to .env and fill in. Never commit .env.

# --- App (Claude) ---
APP_ENV=dev
DEMO_MODE=true
DEMO_JWT_SECRET=change-me-to-a-long-random-string
DEMO_TOKEN_TTL_MINUTES=120
DEMO_TENANT_ID=lumen
QUERY_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8765          # used by Streamlit only

# --- Groq (Claude) --- verify current model IDs at console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL_PLANNER=openai/gpt-oss-120b
GROQ_MODEL_REFINER=openai/gpt-oss-20b
GROQ_MODEL_EVIDENCE_JUDGE=openai/gpt-oss-20b
GROQ_MODEL_ANSWER=openai/gpt-oss-120b
GROQ_MODEL_GROUNDING_CHECK=openai/gpt-oss-20b
GROQ_MODEL_SQL_SPEC=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_VISION_ENABLED=true
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_CONCURRENCY=4
GROQ_MAX_INFRA_RETRIES=3
EVIDENCE_MIN_SCORE=0.35

# --- Embeddings & Chroma (Codex) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=./.chroma
CHUNK_SIMILARITY_THRESHOLD=0.72
CHUNK_MIN_TOKENS=80
CHUNK_MAX_TOKENS=450
BLOB_PATH=./.blobs
MAX_INGEST_BYTES=26214400

# --- Neon Postgres (Codex) --- three distinct roles
NEON_MIGRATION_URL=postgresql://kb_owner:password@host/kb?sslmode=require
NEON_INGEST_URL=postgresql://kb_ingest:password@host/kb?sslmode=require
NEON_QUERY_URL=postgresql://kb_query:password@host/kb?sslmode=require
SQL_TIMEOUT_MS=5000
SQL_MAX_ROWS=200
MIN_AGGREGATION_GROUP=5
